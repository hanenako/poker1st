# 새 환경에서 .env로 복사한 뒤 실제 값 채우기.
DATABASE_URL="postgresql://poker:poker_dev@localhost:15432/poker1st?schema=public"

# nuxt-auth-utils 세션 암호화 키 (32자 이상, 운영시 반드시 변경)
NUXT_SESSION_PASSWORD="change-me-to-a-random-32+-character-string-please"

# 초기 관리자 계정 (시드에서 사용)
ADMIN_EMAIL="admin@local"
ADMIN_PASSWORD="changeme"

# Umami Analytics (선택)
# Umami 배포 후 아래 값 채우기 — https://umami.is 또는 자체 호스팅
NUXT_PUBLIC_UMAMI_SCRIPT_URL=""   # e.g. https://analytics.example.com/script.js
NUXT_PUBLIC_UMAMI_WEBSITE_ID=""   # e.g. xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NUXT_PUBLIC_UMAMI_SHARE_URL=""    # e.g. https://analytics.example.com/share/xxxxx (관리자 embed용)
